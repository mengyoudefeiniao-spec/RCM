# 环境标识与端口基地址配置
VITE_APP_TITLE="国家数字配给卡综合服务与协同管理平台"

# API 模式：true 保留现有演示 Mock API；false 直连 Spring Cloud API
VITE_APP_MOCK_MODE=true

# Spring Cloud Gateway 网关统一服务入口（生产/联调环境）
VITE_APP_API_BASE_URL="http://localhost:8080/api"

# PocketBase 业务数据共享（启用后，跨设备业务缓存同步到 PocketBase）
VITE_POCKETBASE_SYNC=false
VITE_POCKETBASE_URL="https://pb.51xyu.com"
VITE_POCKETBASE_COLLECTION="app_data"
VITE_POCKETBASE_FILES_COLLECTION="app_files"

# 可选：正式环境 Web Push 的 VAPID 公钥；配合后端 /me/push-subscription 与推送服务
VITE_VAPID_PUBLIC_KEY=""
