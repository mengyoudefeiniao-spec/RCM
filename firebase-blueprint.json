{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with authentication and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "role": { "type": "string", "enum": ["citizen", "agent", "admin", "auditor"], "description": "User system role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Family": {
      "title": "Family",
      "description": "Citizen family ration record",
      "type": "object",
      "properties": {
        "rationCardNo": { "type": "string", "description": "Digital ration card number" },
        "headName": { "type": "string", "description": "Household head full name" },
        "province": { "type": "string", "description": "Registered province" },
        "memberCount": { "type": "number", "description": "Number of family members" },
        "status": { "type": "string", "enum": ["正常", "已冻结", "审核中", "待自核"], "description": "Card status" },
        "agentId": { "type": "string", "description": "Assigned distribution agent ID" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["rationCardNo", "headName", "province"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Multi-turn Gemini chat conversation turn",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user UID" },
        "role": { "type": "string", "enum": ["user", "model", "system"], "description": "Chat turn role" },
        "text": { "type": "string", "description": "Message text content" },
        "modelName": { "type": "string", "description": "Model used (gemini-3.5-flash, gemini-3.1-pro-preview, gemini-3.1-flash-lite)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["userId", "role", "text"]
    },
    "ScienceInspection": {
      "title": "ScienceInspection",
      "description": "Biochemical and food science laboratory inspection of ration commodities",
      "type": "object",
      "properties": {
        "commodity": { "type": "string", "description": "Food commodity name" },
        "pubchemCid": { "type": "number", "description": "PubChem Compound ID" },
        "chemicalName": { "type": "string", "description": "Chemical/biological formula" },
        "batchNumber": { "type": "string", "description": "Warehouse grain batch" },
        "inspectionVerdict": { "type": "string", "enum": ["合格 (达标)", "警示 (抽检复核)", "不合格 (扣押)"], "description": "Verdict" },
        "inspectorUid": { "type": "string", "description": "Laboratory inspector UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Inspection timestamp" }
      },
      "required": ["commodity", "batchNumber", "inspectionVerdict"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and RBAC assignment"
    },
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/Family" },
      "description": "Persistent family ration records"
    },
    "/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Persistent multi-turn Gemini conversation logs"
    },
    "/scienceInspections/{inspectionId}": {
      "schema": { "$ref": "#/entities/ScienceInspection" },
      "description": "Laboratory biochemistry inspection records"
    }
  }
}
